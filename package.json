{
  "name": "rec-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build:recs": "cd pipeline && python3 build_recs.py",
    "build:preview": "node scripts/build_preview.mjs",
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute rec-engine --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute rec-engine --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
