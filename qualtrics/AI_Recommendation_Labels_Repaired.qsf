      "Element": "SQ",
      "PrimaryAttribute": "QID27",
      "SecondaryAttribute": "Study debrief",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "Thank you for participating. This study tests whether describing product recommendations as “Recommended by AI” changes trust and choice compared with “Recommended”. Participants were randomly assigned a label but saw the same recommendation content. This prototype pilot uses fictional products and an offline scoring rubric, rather than live AI-generated recommendations. The AI label is an experimental stimulus. Pilot responses test the survey and interface and will not be included in the main-study analysis. A main study will require verified AI recommendations and an updated debrief. No actual purchase took place.",
        "DefaultChoices": false,
        "DataExportTag": "debrief",
        "QuestionType": "DB",
